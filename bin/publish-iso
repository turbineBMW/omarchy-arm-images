#!/bin/bash
# Publish an installer image as a GitHub release the Windows apps find:
# tag installer-<date>, the ISO in parts under GitHub's 2 GiB asset limit,
# and a SHA-256 of the whole image.
#
#   bin/publish-iso ISO
#
# PRERELEASE=1 marks it untested.
set -euo pipefail

root=$(realpath "${BASH_SOURCE[0]%/*}/..")
iso=$(realpath "${1:?usage: bin/publish-iso ISO}")
date=$(basename "$iso" | grep -oE '[0-9]{4}\.[0-9]{2}\.[0-9]{2}' | head -1)
[[ -n $date ]] || { echo "No date in $(basename "$iso")" >&2; exit 1; }
name=omarchy-arm-$date-aarch64.iso
tag=installer-$date
repo=${GH_REPO:-turbineBMW/omarchy-arm-images}

mkdir -p "$root/.cache"
work=$(mktemp -d "$root/.cache/publish-iso.XXXXXX")
trap 'rm -rf "$work"' EXIT

echo "==> Checksum"
(cd "$(dirname "$iso")" && sha256sum "$(basename "$iso")") | awk -v n="$name" '{ print $1 "  " n }' >"$work/$name.sha256"
cat "$work/$name.sha256"

# What the image installs without the network, so the USB creators can tell
# which of a recipe's dependencies the stick has to carry.
echo "==> Offline mirror database"
"$root/bin/iso-offline-db" "$iso" "$work/${name%.iso}.offline.db"
ls -la "$work/${name%.iso}.offline.db"

echo "==> Splitting into parts"
split --bytes=1900M "$iso" "$work/$name.part-"
ls -la "$work"

assets=("$work/$name.sha256" "$work/${name%.iso}.offline.db" "$work/$name".part-*)

echo "==> Release $tag on $repo"
flags=()
[[ ${PRERELEASE:-} != 1 ]] || flags=(--prerelease)
gh release view "$tag" -R "$repo" >/dev/null 2>&1 ||
  gh release create "$tag" -R "$repo" "${flags[@]}" --title "Installer $date${PRERELEASE:+ (untested)}" --notes \
"The Omarchy installer image for Arm laptops, $date. The Omarchy Arm installer and the model installers made from omarchy-arm-installer-recipes download it: they join the parts, check them against $name.sha256, and put the laptop's firmware and any device recipe on the stick. From Linux: cat the parts in order into $name, check it against $name.sha256, then use an installer repository's bin/make-usb."
gh release upload "$tag" -R "$repo" --clobber "${assets[@]}"
